#!/bin/sh
pnpm exec vp lint --deny-warnings 2>/dev/null
status=$?
if [ $status -ne 0 ]; then
	echo "pre-commit: vp lint failed"
	exit $status
fi

if git diff --cached --name-only | grep -q '^\.ruler/'; then
	pnpm rules >/dev/null 2>&1 || exit $?
	if ! git diff --quiet -- AGENTS.md; then
		echo "pre-commit: .ruler changed but AGENTS.md is stale; run pnpm rules"
		exit 1
	fi
fi
