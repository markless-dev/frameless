{
	"name": "frameless-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/markless-dev/frameless.git"
	},
	"scripts": {
		"build": "vp pack",
		"check": "tsc --noEmit",
		"e2e": "node -e \"console.error('Frameless e2e is introduced by T010'); process.exit(1)\"",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"prepare": "git config core.hooksPath .githooks",
		"rules": "npx -y @intellectronica/ruler apply",
		"test": "vp test",
		"test:poc": "for package in poc/*; do if [ -f \"$package/package.json\" ]; then pnpm --dir \"$package\" install --frozen-lockfile && pnpm --dir \"$package\" test || exit $?; fi; done"
	},
	"devDependencies": {
		"@types/node": "24.12.2",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vite-plus": "0.1.20",
		"vitest": "4.1.5"
	},
	"pnpm": {
		"overrides": {
			"@markless/bundler": "file:vendor/markless-bundler-0.1.1.tgz",
			"@markless/compiler": "file:vendor/markless-compiler-0.1.1.tgz",
			"@markless/core": "file:vendor/markless-core-0.1.1.tgz",
			"@markless/router": "file:vendor/markless-router-0.1.1.tgz",
			"@markless/runtime": "file:vendor/markless-runtime-0.1.1.tgz",
			"@markless/serializer": "file:vendor/markless-serializer-0.1.1.tgz",
			"@markless/web": "file:vendor/markless-web-0.1.1.tgz",
			"@tsrx/core": "0.1.32"
		}
	},
	"engines": { "node": ">=20" },
	"packageManager": "pnpm@10.33.2"
}
