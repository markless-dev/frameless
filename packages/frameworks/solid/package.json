{
	"name": "@frameless/solid",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./adapter": "./src/adapter.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"default": "./dist/index.js"
			},
			"./adapter": {
				"default": "./dist/adapter.js"
			}
		}
	},
	"scripts": {
		"measure:size": "node --experimental-strip-types scripts/measure-size.ts",
		"regenerate": "node scripts/regenerate.ts",
		"regenerate:composition": "node scripts/regenerate-composition.ts",
		"test": "vitest run --config vitest.node.config.ts",
		"test:browser": "vitest run --config vitest.config.ts --project solid-browser"
	},
	"dependencies": {
		"@eslint/js": "^9.39.2",
		"@frameless/analyzer": "workspace:*",
		"@frameless/compiler": "workspace:*",
		"eslint": "^9.39.2",
		"eslint-plugin-solid": "0.14.5",
		"globals": "^16.5.0",
		"oxfmt": "0.46.0",
		"pathe": "catalog:",
		"solid-js": "1.8.22"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@vitest/browser-playwright": "4.1.5",
		"babel-preset-solid": "1.9.12",
		"playwright": "1.58.2",
		"solid-beta9": "npm:solid-js@2.0.0-beta.9",
		"vite": "catalog:default",
		"vite-plugin-solid": "2.11.10",
		"vitest": "catalog:default",
		"yuku-analyzer": "0.7.0",
		"yuku-codegen": "0.7.0",
		"yuku-parser": "0.7.0"
	}
}
