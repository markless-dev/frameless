{
	"extends": "../../../tsconfig.json",
	"compilerOptions": { "jsx": "react-jsx", "allowJs": true, "checkJs": false, "types": ["node", "vitest/globals"] },
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
