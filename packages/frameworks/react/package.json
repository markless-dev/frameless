{
	"name": "@frameless/react",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./adapter": "./src/adapter.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"default": "./dist/index.js"
			},
			"./adapter": {
				"default": "./dist/adapter.js"
			}
		}
	},
	"scripts": {
		"measure:size": "node --experimental-strip-types scripts/measure-size.ts",
		"regenerate": "node scripts/regenerate.ts",
		"regenerate:composition": "node scripts/regenerate-composition.ts",
		"test": "vitest run --config vitest.node.config.ts",
		"test:browser": "vitest run --config vitest.config.ts --project react-browser"
	},
	"dependencies": {
		"@eslint/js": "^9.39.2",
		"@frameless/analyzer": "workspace:*",
		"@frameless/compiler": "workspace:*",
		"eslint": "^9.39.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^6.1.1",
		"globals": "^16.5.0",
		"oxfmt": "0.46.0",
		"pathe": "catalog:",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitest/browser-playwright": "4.1.5",
		"playwright": "1.58.2",
		"vite": "catalog:default",
		"vitest": "catalog:default",
		"yuku-analyzer": "0.7.0",
		"yuku-codegen": "0.7.0",
		"yuku-parser": "0.7.0"
	}
}
