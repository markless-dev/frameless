{
  "name": "@frameless/demo-solid-official",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-emitted": "node -e \"require('fs').mkdirSync('src/emitted',{recursive:true});[['S1','RenderOnce'],['S2','KeyedTodo'],['S3','EventForm'],['S4','NestedBoard'],['S5','BranchBoard'],['S6','WhitespaceBoard']].forEach(([s,n])=>require('fs').copyFileSync('../../packages/frameworks/solid/generated/'+s+'.jsx','src/emitted/'+n+'.jsx'))\"",
    "dev": "pnpm copy-emitted && node server",
    "build": "pnpm copy-emitted && vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server"
  },
  "dependencies": { "compression": "^1.8.1", "express": "^5.2.1", "solid-js": "1.8.22", "sirv": "^3.0.2" },
  "devDependencies": { "cross-env": "^10.1.0", "vite": "catalog:", "vite-plugin-solid": "2.11.10" }
}
