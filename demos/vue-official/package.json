{
  "name": "@frameless/demo-vue-official",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-emitted": "node -e \"require('fs').mkdirSync('src/emitted',{recursive:true});[['S1','RenderOnce'],['S2','KeyedTodo'],['S3','EventForm'],['S4','NestedBoard'],['S5','BranchBoard'],['S6','WhitespaceBoard'],['S7','FormBoard'],['S8','AsyncBoard'],['S9','AttrBoard'],['S10','TodoMvc'],['S11','TodoMvcAdvanced'],['S12','CodexClone'],['S13','HnFront']].forEach(([s,n])=>require('fs').copyFileSync('../../packages/frameworks/vue/generated/'+s+'.vue','src/emitted/'+n+'.vue'))\"",
    "copy-todomvc-css": "node ../shared/copy-todomvc-css.mjs public",
    "copy-shadcn-theme": "node ../shared/copy-shadcn-theme.mjs public",
    "copy-hn-css": "node ../shared/copy-hn-css.mjs public",
    "dev": "pnpm copy-emitted && pnpm copy-todomvc-css && pnpm copy-shadcn-theme && pnpm copy-hn-css && node server",
    "build": "pnpm copy-emitted && pnpm copy-todomvc-css && pnpm copy-shadcn-theme && pnpm copy-hn-css && vue-tsc -b && npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node server"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "sirv": "^3.0.2",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vue-tsc": "^3.2.6"
  }
}
