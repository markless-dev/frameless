{
	"name": "svelte-official",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"copy-emitted": "node -e \"require('fs').mkdirSync('src/lib/emitted',{recursive:true});[['S1','RenderOnce'],['S2','KeyedTodo'],['S3','EventForm'],['S4','NestedBoard'],['S5','BranchBoard'],['S6','WhitespaceBoard'],['S7','FormBoard'],['S8','AsyncBoard'],['S9','AttrBoard'],['S10','TodoMvc']].forEach(([s,n])=>require('fs').copyFileSync('../../packages/frameworks/svelte/generated/'+s+'.svelte','src/lib/emitted/'+n+'.svelte'))\"",
		"dev": "pnpm copy-emitted && vite dev",
		"build": "pnpm copy-emitted && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
