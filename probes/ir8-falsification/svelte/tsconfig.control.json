{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": false,
		"types": []
	},
	"include": ["control/Child.svelte", "control/Parent.svelte"]
}
