{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": []
	},
	"angularCompilerOptions": {
		"strictTemplates": true,
		"strictInjectionParameters": true,
		"strictInputAccessModifiers": true
	},
	"files": []
}
