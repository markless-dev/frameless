{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node", "vitest/globals"]
	},
	"exclude": ["dist", "node_modules", "poc", "packages/*/test", "tests"],
	"include": [
		"packages/*/src/**/*.d.ts",
		"packages/*/src/**/*.ts",
		"packages/frameworks/*/src/**/*.ts",
		"packages/frameworks/*/vitest.config.ts",
		"vite.config.ts"
	]
}
